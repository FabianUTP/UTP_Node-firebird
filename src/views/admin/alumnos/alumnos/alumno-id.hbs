      <li class="nav-item">
        <button class="nav-link custom-tab-button" data-bs-toggle="tab" data-bs-target="#Estatus">
          <i class="fas fa-info-circle"></i> Estatus
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link custom-tab-button" data-bs-toggle="tab" data-bs-target="#BACHILLERATO">
          <i class="fas fa-school"></i> Bachillerato
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link custom-tab-button" data-bs-toggle="tab" data-bs-target="#Estadisticos">
          <i class="fas fa-chart-bar"></i> Estadísticos
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link custom-tab-button" data-bs-toggle="tab" data-bs-target="#Titulacion_Tsu">
          <i class="fas fa-graduation-cap"></i> Titulación TSU
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link custom-tab-button" data-bs-toggle="tab" data-bs-target="#Titulacion_Lic">
          <i class="fas fa-user-tie"></i> Titulación Lic
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link custom-tab-button" data-bs-toggle="tab" data-bs-target="#Folios_Doctos_TSU">
          <i class="fas fa-file-alt"></i> Documentos TSU
